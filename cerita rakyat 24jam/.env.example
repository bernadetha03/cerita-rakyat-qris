APP_NAME="Cerita Rakyat Nusantara"
# Local: http://localhost:8080
# Railway: kosongkan APP_URL; aplikasi akan memakai RAILWAY_PUBLIC_DOMAIN otomatis.
APP_URL=
APP_TIMEZONE=Asia/Jayapura
APP_ENV=production

# LOCAL MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cerita_rakyat
DB_USERNAME=root
DB_PASSWORD=

# Railway: gunakan Reference Variables dari service MySQL:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false
PAYMENT_SIMULATION=true
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_YANG_KUAT
